# Copie para .env e ajuste antes de rodar em produção.

# Porta do servidor HTTP (a Render define a dela sozinha; não precisa setar lá)
PORT=3000

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório forte,
# por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-forte

# Tempo de expiração do token de sessão
JWT_EXPIRES_IN=12h

# String de conexão do Postgres. Localmente, algo como:
#   postgres://usuario:senha@localhost:5432/bolosdabru
# Na Render, copie a "Internal Database URL" do seu banco Postgres.
DATABASE_URL=postgres://usuario:senha@localhost:5432/bolosdabru

# Credenciais da conta administradora criada automaticamente na primeira
# inicialização (apenas se ainda não existir nenhum usuário admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Bru . Administradora

# Origem(s) do frontend autorizadas a chamar a API (separadas por vírgula).
CORS_ORIGIN=http://127.0.0.1:4173,http://localhost:4173
